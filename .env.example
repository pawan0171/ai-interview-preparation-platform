# ==============================================
# PrepAI Platform - Environment Configuration
# ==============================================

# Server Port
PORT=5000

# MongoDB Connection String (in Docker, use service name 'mongo')
# Local: mongodb://127.0.0.1:27017/ai-interview-db
# Docker: mongodb://mongo:27017/ai-interview-db
MONGO_URI=mongodb://mongo:27017/ai-interview-db

# Redis Connection URL (in Docker, use service name 'redis')
# Local: redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# JWT Signing Secret
JWT_SECRET=super_secret_interview_jwt_key_123_abc_!@#

# Google Gemini 1.5 Flash API Key (leave empty for automatic mock engine fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Credentials (optional - falls back to local /uploads directory)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
